# SymbiYosys 設定檔。執行方式 (在 formal/ 目錄下):
#   sby -f wdt.sby bmc        # 檢查 assert (有界模型檢查)
#   sby -f wdt.sby cover      # 產生 cover 的示範波形
#   sby -f wdt.sby irq_demo   # 故意失敗，看反例波形
#   sby -f wdt.sby            # 三個 task 全跑

[tasks]
bmc
cover
irq_demo

[options]
# bmc = Bounded Model Check: 從 reset 起，把「所有」可能的輸入序列
#       展開 depth 拍，看有沒有任何一條會違反 assert。
bmc:      mode bmc
bmc:      depth 100
# cover: 找出一條最短的輸入序列讓每個 cover() 成立
cover:    mode cover
cover:    depth 80
irq_demo: mode bmc
irq_demo: depth 60

[engines]
# smtbmc = 把電路翻成 SMT 公式，丟給 solver。yices 是這裡最快的通用選擇。
smtbmc yices

[script]
# 用 slang 前端讀 SystemVerilog，而不是 yosys 內建的 read -formal。
# 原因：內建前端不支援 dut.lock 這種階層參照 (bind 也只會 parse 不會生效)，
# 有了 slang，wrapper 才能直接 assert DUT 內部的 reg，RTL 一行不用改。
plugin -i slang
irq_demo: read_slang -D DEMO_BUG --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
bmc:      read_slang --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
cover:    read_slang --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
prep -top wdt_formal

[files]
../src/clk_div_pow2.v
../src/spi_regs.v
../src/project.v
wdt_formal.sv
