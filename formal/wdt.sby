# SymbiYosys configuration. Run from formal/ with the Makefile:
#   make bmc        bounded model check, checks the asserts
#   make cover      produce a waveform for each cover
#   make proof      k-induction, proves the asserts hold forever
#   make irq_demo   deliberately failing example, shows a counterexample
#   make all        all four (irq_demo is expected to FAIL)

[tasks]
bmc
proof
cover
irq_demo

[options]
# bmc = bounded model check: unroll every possible input sequence from reset
#       for `depth` cycles and look for one that violates an assert.
#       Defaults to 20 if omitted, which is not enough here: a single SPI
#       frame already takes 22 cycles.
bmc:      mode bmc
bmc:      depth 100

# prove = k-induction: proves a property holds forever rather than just for
#         `depth` cycles. Here `depth` is the induction window k, not a trace
#         length, and it does not change the strength of the result: a pass at
#         depth 3 and a pass at depth 40 are the same theorem. 5 is the
#         measured minimum for this design; leave headroom.
proof:    mode prove
proof:    depth 5

# cover: find the shortest input sequence that satisfies each cover()
cover:    mode cover
cover:    depth 80

irq_demo: mode bmc
irq_demo: depth 60

[engines]
# smtbmc translates the circuit into SMT formulas for a solver.
# yices is the fastest general-purpose choice here.
smtbmc yices

[script]
# Read with the slang frontend rather than the built-in `read -formal`.
# The built-in frontend cannot resolve hierarchical references such as
# dut.lock, and silently drops SystemVerilog `bind` instead of applying it,
# which would give a green light on properties that never entered the design.
# With slang the wrapper can assert on the DUT's internal registers and
# src/ stays untouched.
plugin -i slang
irq_demo: read_slang -D DEMO_BUG --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
bmc:      read_slang --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
proof:    read_slang --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
cover:    read_slang --top wdt_formal clk_div_pow2.v spi_regs.v project.v wdt_formal.sv
prep -top wdt_formal

[files]
../src/clk_div_pow2.v
../src/spi_regs.v
../src/project.v
wdt_formal.sv
